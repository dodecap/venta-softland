APP_NAME="Venta Softland"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://172.30.205.106:8086/venta-softland

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos ---
# La app trabaja SOBRE la base Softland (SQL Server), en su propio esquema `ventas`.
# La conexión REAL se define en /setup y queda cifrada en storage/app/private.
# Estas variables son solo el fallback para desarrollo y para la CLI.
DB_CONNECTION=softland
SOFTLAND_DB_HOST="localhost\\MSSQLSERVER2022"
SOFTLAND_DB_PORT=
SOFTLAND_DB_DATABASE=INNOVAGES
SOFTLAND_DB_USERNAME=sa
SOFTLAND_DB_PASSWORD=
SOFTLAND_DB_SCHEMA=ventas
SOFTLAND_DB_TRUST_CERT=true

# Antes de /setup la app tiene que arrancar sin base de datos:
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# --- Correo ---
# El SMTP real se configura en /configuracion/correo y queda cifrado en disco.
# Sin configurar, los correos van al log (no se envía nada).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="ventas@innovages.cl"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Documentos tributarios electrónicos ---
# El certificado digital va en storage/app/private/ (fuera de git) y su clave
# aquí. Nunca en el nombre del archivo: quien liste la carpeta la lee.
DTE_CERT_RUTA=
DTE_CERT_CLAVE=
# «produccion» (palena) o «certificacion» (maullin). Una vez cerrada la
# declaración de cumplimiento, el SII cierra maullin para ese RUT.
DTE_AMBIENTE=produccion
