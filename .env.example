APP_NAME="Venta Softland"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_CL
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- Base de datos ---
# La app trabaja SOBRE la base Softland (SQL Server), en su propio esquema `ventas`.
# La conexión REAL se define en /setup y queda cifrada en storage/app/private.
# Estas variables son solo el fallback para desarrollo y para la CLI.
DB_CONNECTION=softland
# La conexión de verdad NO se escribe aquí: la pide /setup en el navegador y se
# guarda cifrada en storage/app/private/softland.json, fuera de git. Lo de abajo
# son sólo los valores por omisión de antes de instalar.
SOFTLAND_DB_HOST=
SOFTLAND_DB_PORT=
SOFTLAND_DB_DATABASE=
SOFTLAND_DB_USERNAME=
SOFTLAND_DB_PASSWORD=
SOFTLAND_DB_SCHEMA=ventas
SOFTLAND_DB_TRUST_CERT=true

# Antes de /setup la app tiene que arrancar sin base de datos:
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=file

# --- Correo ---
# El SMTP real se configura en /configuracion/correo y queda cifrado en disco.
# Sin configurar, los correos van al log (no se envía nada).
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Documentos tributarios electrónicos ---
# El certificado digital NO hace falta ponerlo aquí: se sube desde la app, en
# Configuración -> Certificado digital, y queda cifrado en el servidor. Estas
# dos líneas son el respaldo para las instalaciones que ya lo tenían puesto a
# mano; lo subido desde la app manda sobre ellas.
DTE_CERT_RUTA=
DTE_CERT_CLAVE=
# «produccion» (palena) o «certificacion» (maullin). Una vez cerrada la
# declaración de cumplimiento, el SII cierra maullin para ese RUT.
DTE_AMBIENTE=produccion
