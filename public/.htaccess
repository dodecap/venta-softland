<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Servido bajo subcarpeta en Apache (XAMPP): /venta-softland -> public/.
    # Sin esto el front controller entra en bucle de redirecciones internas.
    RewriteBase /venta-softland/

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # La redirección de la barra final que trae Laravel de fábrica va aquí
    # quitada, y no es una limpieza: detrás del proxy **rompía la página**.
    # Redirigía a `%1`, que es la ruta tal como la ve Apache —con la carpeta
    # `/venta-softland` dentro—, así que pedir `https://venta.netdomain.cl/app/`
    # contestaba un 301 a `http://venta.netdomain.cl/venta-softland/app`: una
    # dirección que el proxy no sabe mapear, y un 404. Sin la regla, `/app/`
    # llega al front controller y Laravel la resuelve, que es lo que hace con
    # la barra final de todas formas.
    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# --- Rendimiento (Venta Softland) ---
# Comprime HTML/JSON/JS/CSS: el bundle viaja ~3x más liviano al celular.
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Los assets compilados llevan hash en el nombre → cachearlos fuerte (1 año, inmutables).
<IfModule mod_headers.c>
    <FilesMatch "\.(js|mjs|css|woff2?|ttf|svg|png|jpe?g|gif|webp|ico)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>
